{
  "name": "WorkloadGovernor Dev",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bullseye",

  // Forward all service ports to the host
  "forwardPorts": [3000, 5173, 5432, 6379, 5050],
  "portsAttributes": {
    "3000": { "label": "Backend API" },
    "5173": { "label": "Frontend (Vite)" },
    "5432": { "label": "PostgreSQL" },
    "6379": { "label": "Redis" },
    "5050": { "label": "pgAdmin" }
  },

  "features": {
    // Rust toolchain pinned to stable with both Soroban WASM targets installed
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "default",
      "targets": "wasm32-unknown-unknown,wasm32v1-none"
    },
    // Node.js 20 LTS with npm in standard PATH
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "nodeGypDependencies": true,
      "nvmInstallPath": "/usr/local/share/nvm"
    },
    // Docker-in-Docker support for local service containers inside Codespaces / VS Code
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // Stellar CLI (latest released version)
    "ghcr.io/devcontainers-contrib/features/stellar-cli:1": {}
  },

  // Guarantee node, npm, cargo, and rustup are on PATH in every terminal session
  "containerEnv": {
    "CARGO_HOME": "/usr/local/cargo",
    "RUSTUP_HOME": "/usr/local/rustup",
    "NVM_DIR": "/usr/local/share/nvm"
  },
  "remoteEnv": {
    "PATH": "/usr/local/cargo/bin:/home/vscode/.cargo/bin:/usr/local/share/nvm/current/bin:${containerEnv:PATH}"
  },

  // Install project dependencies and copy env files the first time the container starts
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // VS Code / Cursor extensions that improve the Rust + TypeScript experience
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "cweijan.vscode-redis-client"
      ],
      "settings": {
        "rust-analyzer.cargo.features": ["testutils"],
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },

  // Run as the non-root vscode user that ships in the base image
  "remoteUser": "vscode"
}
