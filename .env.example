# ── Backend ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workload_governor
POSTGRES_PORT=5432
# Full connection string (constructed automatically by docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workload_governor

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Stellar / Soroban RPC ──────────────────────────────────────────────────
# Local quickstart node — change to testnet/mainnet URL for non-local envs
STELLAR_PORT=8000
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017
# Deployed contract ID (leave empty until first deploy)
CONTRACT_ID=

# ── pgAdmin (dev convenience, not needed in CI) ────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ── AWS (only required for infra / CI jobs) ────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/github-actions
# RDS_DB_INSTANCE_ID=workload-governor-prod
# SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:devops-alerts
