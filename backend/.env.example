# WorkloadGovernor backend — environment variables
# Copy to .env and fill in real values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Use DATABASE_URL or individual PG* vars
DATABASE_URL=postgresql://postgres:password@localhost:5432/workload_governor
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=workload_governor
# PGUSER=postgres
# PGPASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Soroban / Stellar ────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CONTRACT_ID=<your-contract-id>
SOROBAN_SOURCE_SECRET=<your-stellar-secret-key>

# ── Horizon ──────────────────────────────────────────────────────────────────
HORIZON_URL=https://horizon-testnet.stellar.org

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=<your-github-pat>
# Comma-separated owner/repo pairs (fallback if registered_repos table is empty)
SYNC_REPOS=FaveTeamz/workload-governor
