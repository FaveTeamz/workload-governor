{
  "name": "workload-governor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WorkloadGovernor backend service — GitHub sync, health check, TTL scheduler",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev":     "tsx watch src/app.ts",
