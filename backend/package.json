{
  "name": "workload-governor-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/instrumentation-express": "0.57.1",
    "@opentelemetry/instrumentation-http": "0.57.2",
    "@opentelemetry/instrumentation-pg": "0.57.0",
    "@opentelemetry/propagator-aws-xray": "1.26.0",
    "@opentelemetry/sdk-node": "0.57.2",
    "aws-xray-sdk-core": "3.6.0"
  },
  "devDependencies": {
    "@types/aws-xray-sdk": "2.3.6",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.2",
    "@types/nock": "11.1.0",
    "jest": "29.7.0",
    "nock": "13.5.4",
    "ts-jest": "29.1.5",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/__tests__/**"
    ]
  }
}
