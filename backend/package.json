    "pg":             "8.11.5",
    "ioredis":        "5.3.2",
    "pino":           "9.0.0",
    "pino-pretty":    "11.0.0",
    "@stellar/stellar-sdk": "12.3.0"
  },
  "devDependencies": {
    "@types/express":    "4.17.21",
    "@types/node":       "20.12.12",
    "@types/node-cron":  "3.0.11",
    "@types/pg":         "8.11.6",
    "typescript":        "5.4.5",
    "tsx":               "4.10.2",
    "vitest":            "1.6.0",
    "@vitest/coverage-v8": "1.6.0"
  }
