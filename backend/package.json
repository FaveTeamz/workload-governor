{
  "name": "workload-governor-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:seed": "ts-node ../scripts/seed-mock-data.ts",
    "test:vitest": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.2",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/propagator-aws-xray": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.223.2",
    "@stellar/stellar-sdk": "12.3.0",
    "aws-xray-sdk-core": "3.6.0",
    "express": "4.19.2",
    "helmet": "^8.3.0",
    "ioredis": "5.3.2",
    "node-cron": "3.0.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "8.11.5",
    "pino": "9.0.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/nock": "11.1.0",
    "@types/node": "20.14.2",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.11.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "1.6.0",
    "jest": "29.7.0",
    "nock": "13.5.4",
    "supertest": "^7.3.2",
    "ts-jest": "29.1.5",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/__tests__/**"
    ]
  }
}
