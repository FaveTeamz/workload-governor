{
  "meta": {
    "version": "1.0.0",
    "description": "WorkloadGovernor design tokens — mirrors tokens.css semantic layer"
  },
  "color": {
    "surface":               { "value": "var(--color-surface)",           "description": "Page/card background" },
    "surfaceRaised":         { "value": "var(--color-surface-raised)",    "description": "Raised card / panel" },
    "surfaceOverlay":        { "value": "var(--color-surface-overlay)",   "description": "Dropdown / tooltip background" },
    "surfaceInset":          { "value": "var(--color-surface-inset)",     "description": "Input / inset area" },
    "surfaceInverse":        { "value": "var(--color-surface-inverse)",   "description": "Inverse (dark-on-light / light-on-dark)" },
    "textPrimary":           { "value": "var(--color-text-primary)",      "description": "Body copy, headings" },
    "textSecondary":         { "value": "var(--color-text-secondary)",    "description": "Captions, metadata" },
    "textTertiary":          { "value": "var(--color-text-tertiary)",     "description": "Placeholder, hints" },
    "textDisabled":          { "value": "var(--color-text-disabled)",     "description": "Disabled state" },
    "textOnBrand":           { "value": "var(--color-text-on-brand)",     "description": "Text on brand-colored backgrounds" },
    "textLink":              { "value": "var(--color-text-link)",         "description": "Hyperlinks" },
    "textLinkHover":         { "value": "var(--color-text-link-hover)",   "description": "Hyperlink hover state" },
    "brand":                 { "value": "var(--color-brand)",             "description": "Primary brand / CTA" },
    "brandHover":            { "value": "var(--color-brand-hover)",       "description": "Brand hover" },
    "brandActive":           { "value": "var(--color-brand-active)",      "description": "Brand pressed" },
    "brandSubtle":           { "value": "var(--color-brand-subtle)",      "description": "Low-contrast brand tint" },
    "border":                { "value": "var(--color-border)",            "description": "Default border" },
    "borderStrong":          { "value": "var(--color-border-strong)",     "description": "Emphasized border" },
    "borderFocus":           { "value": "var(--color-border-focus)",      "description": "Focus ring color" },
    "success":               { "value": "var(--color-success)",           "description": "Success state" },
    "successSubtle":         { "value": "var(--color-success-subtle)",    "description": "Success background tint" },
    "warning":               { "value": "var(--color-warning)",           "description": "Warning state" },
    "warningSubtle":         { "value": "var(--color-warning-subtle)",    "description": "Warning background tint" },
    "error":                 { "value": "var(--color-error)",             "description": "Error / destructive" },
    "errorSubtle":           { "value": "var(--color-error-subtle)",      "description": "Error background tint" }
  }
}
