// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Badge snapshots > error 1`] = `
<div>
  <span
    class="badge badge--error"
  >
    Failed
  </span>
</div>
`;

exports[`Badge snapshots > info 1`] = `
<div>
  <span
    class="badge badge--info"
  >
    Draft
  </span>
</div>
`;

exports[`Badge snapshots > neutral (default) 1`] = `
<div>
  <span
    class="badge badge--neutral"
  >
    Unknown
  </span>
</div>
`;

exports[`Badge snapshots > success 1`] = `
<div>
  <span
    class="badge badge--success"
  >
    Completed
  </span>
</div>
`;

exports[`Badge snapshots > warning 1`] = `
<div>
  <span
    class="badge badge--warning"
  >
    Pending
  </span>
</div>
`;

exports[`Button snapshots > disabled 1`] = `
<div>
  <button
    class="btn btn-primary"
    disabled=""
  >
    Unavailable
  </button>
</div>
`;

exports[`Button snapshots > ghost 1`] = `
