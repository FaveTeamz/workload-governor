exports[`Modal snapshots > open with footer 1`] = `
<div>
  <dialog
    aria-labelledby="modal-title"
    class="modal"
    open=""
  >
    <div
      class="modal__content"
    >
      <div
        class="modal__header"
      >
        <h2
          class="modal__title"
          id="modal-title"
        >
          Delete Item
        </h2>
        <button
          aria-label="Close"
          class="modal__close"
        >
          ✕
        </button>
      </div>
      <div
        class="modal__body"
      >
        <p>
          This action cannot be undone.
        </p>
      </div>
      <div
        class="modal__footer"
      >
        <button>
          Cancel
        </button>
        <button>
          Delete
        </button>
      </div>
    </div>
  </dialog>
</div>
`;

exports[`Table snapshots > empty (no rows) 1`] = `
<div>
  <div
    aria-label="Contributors"
    class="table-wrap"
    role="region"
    tabindex="0"
  >
    <table
      class="table"
    >
      <caption
        class="table__caption"
      >
        Contributors
      </caption>
      <thead>
        <tr>
          <th
            scope="col"
          >
            ID
          </th>
          <th
            scope="col"
          >
            Name
          </th>
          <th
            scope="col"
          >
            Status
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td
            class="table__empty"
            colspan="3"
          >
            No data
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
`;

