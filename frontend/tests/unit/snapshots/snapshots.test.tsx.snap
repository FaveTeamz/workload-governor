exports[`Gauge snapshots > 0% (value=0, max=15) 1`] = `
<div>
  <div
    aria-label="Global Applications: 0 of 15"
    class="gauge"
  >
    <div
      class="gauge__label"
    >
      Global Applications
    </div>
    <div
      class="gauge__count"
    >
      <span
        aria-atomic="true"
        aria-label="0 of 15"
        aria-live="polite"
        class="gauge__animated-value"
      >
        0
      </span>
      <span
        aria-hidden="true"
        class="gauge__separator"
      >
        /
      </span>
      <span
        aria-hidden="true"
        class="gauge__max"
      >
        15
      </span>
    </div>
    <div
      aria-label="Global Applications: 0 of 15"
      aria-valuemax="15"
      aria-valuemin="0"
      aria-valuenow="0"
      class="gauge__track"
      role="progressbar"
    >
      <div
        class="gauge__fill"
        style="width: 0%; background: var(--color-success-500, #22c55e); transition: width 400ms ease-out;"
      />
    </div>
  </div>
</div>
`;

