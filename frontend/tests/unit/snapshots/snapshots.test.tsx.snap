exports[`Gauge snapshots > ~50% realistic (value=7, max=15) 1`] = `
<div>
  <figure
    aria-label="Global Applications"
    class="gauge"
  >
    <svg
      aria-label="Global Applications: 7 of 15"
      height="120"
      role="img"
      viewBox="0 0 120 120"
      width="120"
    >
      <path
        d="M 27.755930777893433 92.24406922210656 A 45.6 45.6 0 1 1 92.2440692221066 92.24406922210653"
        fill="none"
        stroke="var(--color-border)"
        stroke-linecap="round"
        stroke-width="12"
      />
      <path
        d="M 27.755930777893433 92.24406922210656 A 45.6 45.6 0 0 1 52.86658839416546 14.961411668861722"
        fill="none"
        stroke="var(--color-success-500)"
        stroke-linecap="round"
        stroke-width="12"
      />
      <text
        class="gauge__pct"
        fill="var(--color-text)"
        text-anchor="middle"
        x="60"
        y="56"
      >
        47
        %
      </text>
      <text
        class="gauge__value"
        fill="var(--color-muted)"
        text-anchor="middle"
        x="60"
        y="74"
      >
        7
        /
        15
      </text>
    </svg>
    <figcaption
      class="gauge__label"
    >
      Global Applications
    </figcaption>
  </figure>
</div>
`;

