exports[`Modal snapshots > closed 1`] = `
<div>
  <dialog
    aria-labelledby="modal-title"
    class="modal"
  >
    <div
      class="modal__content"
    >
      <div
        class="modal__header"
      >
        <h2
          class="modal__title"
          id="modal-title"
        >
          Confirm Action
        </h2>
        <button
          aria-label="Close"
          class="modal__close"
        >
          ✕
        </button>
      </div>
      <div
        class="modal__body"
      >
        <p>
          Are you sure you want to proceed?
        </p>
      </div>
    </div>
  </dialog>
</div>
`;

