{
  "name": "workload-governor",
  "version": "1.0.0",
  "description": "WorkloadGovernor sync service and API for the Stellar/Soroban contributor platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' --max-warnings 0",
    "typecheck": "tsc -p tsconfig.dev.json --noEmit",
    "test": "jest --config jest.config.ts --testPathPattern=tests/",
    "validate:api": "dredd openapi.yaml http://localhost:3001 --hookfiles=dredd-hooks.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-openapi-validator": "5.3.7",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "pg": "8.12.0",
    "pino": "9.3.2",
    "pino-http": "10.2.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.14",
    "@types/pg": "8.11.6",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "dredd": "14.1.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}
