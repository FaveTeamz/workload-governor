{
  "name": "workload-governor",
  "version": "1.0.0",
  "description": "WorkloadGovernor sync service and API for the Stellar/Soroban contributor platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --migrations-table pgmigrations",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migrations-table pgmigrations",
    "test": "jest --runInBand --forceExit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "coverage": "npm run coverage:backend && npm run coverage:frontend",
    "coverage:backend": "jest --runInBand --forceExit --coverage --coverageReporters=lcov --coverageReporters=text",
    "coverage:frontend": "npm --prefix frontend run coverage"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "@types/morgan": "1.9.9",
    "@types/swagger-ui-express": "4.1.6",
    "@types/uuid": "10.0.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "eventsource": "2.0.2",
    "express": "4.19.2",
    "express-openapi-validator": "5.3.7",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "morgan": "1.10.0",
    "pg": "8.12.0",
    "pino": "9.3.2",
    "pino-http": "10.2.0",
    "swagger-ui-express": "5.0.1",
    "uuid": "10.0.0",
    "yaml": "2.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/eventsource": "1.1.15",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/morgan": "^1.9.10",
    "@types/node": "20.14.14",
    "@types/pg": "8.11.6",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-istanbul": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "8.57.0",
    "fast-check": "^3.22.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}
