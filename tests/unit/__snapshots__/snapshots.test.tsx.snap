exports[`MaintainerPanel snapshots > empty state 1`] = `
<section
  aria-label="Maintainer Panel"
  class="maintainer-panel"
>
  <div
    class="panel-columns"
  >
    <div
      class="panel-column"
    >
      <h2
        id="applications-heading"
      >
        Pending Applications
        <span
          aria-atomic="true"
          aria-label="0 pending applications"
          aria-live="polite"
          class="count-badge"
        >
          0
        </span>
      </h2>
      <div
        aria-label="No applications yet"
        class="empty-state empty-state--compact"
        role="status"
      >
        <div
          class="empty-state__icon empty-state__icon--sm"
        >
          <svg
            aria-hidden="true"
            class="empty-state__svg"
            fill="none"
            viewBox="0 0 64 64"
          >
            <rect
              height="36"
              rx="4"
              stroke="currentColor"
              stroke-width="3.5"
              width="48"
              x="8"
              y="20"
            />
            <path
              d="M8 38h14l4 6h12l4-6h14"
              stroke="currentColor"
              stroke-linejoin="round"
              stroke-width="3.5"
            />
            <line
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="2.5"
              x1="32"
              x2="32"
              y1="8"
              y2="22"
            />
            <polyline
              points="24,14 32,8 40,14"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
            />
          </svg>
        </div>
        <p
          class="empty-state__title empty-state__title--sm"
        >
          No applications yet
        </p>
        <button
          class="btn btn-primary btn-sm empty-state__cta"
        >
          Browse issues
        </button>
      </div>
    </div>
    <div
      class="panel-column"
    >
      <h2
        id="assignments-heading"
      >
        Active Assignments
        <span
          aria-atomic="true"
          aria-label="0 active assignments"
          aria-live="polite"
          class="count-badge"
        >
          0
        </span>
      </h2>
      <div
        aria-label="No active assignments"
        class="empty-state empty-state--compact"
        role="status"
      >
        <div
          class="empty-state__icon empty-state__icon--sm"
        >
          <svg
            aria-hidden="true"
            class="empty-state__svg"
            fill="none"
            viewBox="0 0 64 64"
          >
            <rect
              height="44"
              rx="4"
              stroke="currentColor"
              stroke-width="3.5"
              width="36"
              x="14"
              y="12"
            />
            <rect
              height="8"
              rx="2"
              stroke="currentColor"
              stroke-width="2.5"
              width="20"
              x="22"
              y="8"
            />
            <line
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="2.5"
              x1="22"
              x2="42"
              y1="28"
              y2="28"
            />
            <line
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="2.5"
              x1="22"
              x2="36"
              y1="36"
              y2="36"
            />
          </svg>
        </div>
        <p
          class="empty-state__title empty-state__title--sm"
        >
          No active assignments
        </p>
        <button
          class="btn btn-primary btn-sm empty-state__cta"
        >
          Apply for an issue
        </button>
      </div>
    </div>
  </div>
</section>
`;

exports[`MaintainerPanel snapshots > with applications and assignments 1`] = `
<section
  aria-label="Maintainer Panel"
  class="maintainer-panel"
>
  <div
    class="panel-columns"
  >
    <div
      class="panel-column"
    >
      <h2
        id="applications-heading"
      >
        Pending Applications
        <span
          aria-atomic="true"
          aria-label="1 pending applications"
          aria-live="polite"
          class="count-badge"
        >
          1
        </span>
      </h2>
      <ul
        aria-label="Pending applications list"
        aria-labelledby="applications-heading"
        class="panel-list"
      >
        <li
          class="panel-row"
        >
          <div
            class="row-info"
          >
            <span
              aria-label="Contributor: GBXXX1ABCDEFGHIJKLMNO12345"
              class="contributor"
              title="GBXXX1ABCDEFGHIJKLMNO12345"
            >
              GBXXX1AB…O12345
            </span>
            <span
              aria-label="Organisation: stellar-org"
              class="org"
            >
              stellar-org
            </span>
            <span
              aria-label="Issue: Fix bug"
              class="issue-title"
            >
              Fix bug
            </span>
            <time
              aria-label="Applied on 6/20/2026"
              class="date"
              datetime="2026-06-20"
            >
              6/20/2026
            </time>
          </div>
          <div
            class="row-actions"
          >
            <button
              aria-label="Assign Fix bug to GBXXX1AB…O12345"
              class="btn btn-primary btn-sm"
            >
              Assign
            </button>
          </div>
        </li>
      </ul>
    </div>
    <div
      class="panel-column"
    >
      <h2
        id="assignments-heading"
      >
        Active Assignments
        <span
          aria-atomic="true"
          aria-label="1 active assignments"
          aria-live="polite"
          class="count-badge"
        >
          1
        </span>
      </h2>
      <ul
        aria-label="Active assignments list"
        aria-labelledby="assignments-heading"
        class="panel-list"
      >
        <li
          class="panel-row"
        >
          <div
            class="row-info"
          >
            <span
              aria-label="Contributor: GBXXX1ABCDEFGHIJKLMNO12345"
              class="contributor"
              title="GBXXX1ABCDEFGHIJKLMNO12345"
            >
              GBXXX1AB…O12345
            </span>
            <span
              aria-label="Organisation: stellar-org"
              class="org"
            >
              stellar-org
            </span>
            <span
              aria-label="Issue: Optimise WASM"
              class="issue-title"
            >
              Optimise WASM
            </span>
          </div>
          <div
            class="row-actions"
          >
            <button
              aria-busy="false"
              aria-label="Mark Optimise WASM as complete for GBXXX1AB…O12345"
              class="btn btn-complete btn-sm"
            >
              Complete
            </button>
            <button
              aria-busy="false"
              aria-label="Revoke assignment of Optimise WASM from GBXXX1AB…O12345"
              class="btn btn-revoke btn-sm"
            >
              Revoke
            </button>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>
`;

exports[`NavBar snapshots > connected 1`] = `
<nav
  aria-label="Main navigation"
  class="navbar"
  role="navigation"
>
  <a
    aria-label="WorkloadGovernor home"
    class="navbar__brand"
    href="#/"
  >
    <span
      aria-hidden="true"
    >
      ⚙
    </span>
     WorkloadGovernor
  </a>
  <button
    aria-controls="navbar-menu"
    aria-expanded="false"
    aria-label="Open navigation menu"
    class="navbar__hamburger"
  >
    <span
      class="hamburger-bar"
    />
    <span
      class="hamburger-bar"
    />
    <span
      class="hamburger-bar"
    />
  </button>
  <div
    class="navbar__menu"
    id="navbar-menu"
  >
    <a
      class="navbar__link"
      href="#/activity"
    >
      Activity
    </a>
    <div
      class="navbar__wallet"
    >
      <span
        aria-label="Connected wallet: GBTEST1234ABCD"
        class="navbar__address"
        title="GBTEST1234ABCD"
      >
        GBTEST…ABCD
      </span>
      <button
        aria-label="Disconnect wallet"
        class="btn btn-ghost btn-sm"
      >
        Disconnect
      </button>
    </div>
  </div>
</nav>
`;

